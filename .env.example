# Optional overrides. Copy to .env, then `docker compose up -d`: cp .env.example .env
# docker-compose.yml reads these with ${VAR:-default}, so anything you set here wins.

# Fraction of traces to keep. 1.0 = all, 0.1 = 10%.
OTEL_TRACES_SAMPLER_ARG=1.0

# grpc -> port 4317, http/protobuf -> port 4318. Mismatch them and no spans reach
# Jaeger, though the exporter does log the failures: docker compose logs gui
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
